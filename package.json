{
  "name": "@loctax/nest-pg-boss",
  "version": "5.2.1",
  "description": "Use pg-boss in your NestJS app",
  "author": "Julian Tölle <julian.toelle97@gmail.com> & Loctax team",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loc-tax/nest-pg-boss.git"
  },
  "bugs": {
    "url": "https://github.com/apricote/nest-pg-boss/issues"
  },
  "main": "./dist/index.js",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.mts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.mts\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.18",
    "pg-boss": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "22.20.1",
    "oxlint": "1.80.0",
    "pg-boss": "9.0.3",
    "prettier": "3.9.6",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "5.0.0"
  }
}
