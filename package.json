{
  "name": "@loctax/nest-pg-boss",
  "version": "5.0.3",
  "description": "Use pg-boss in your NestJS app",
  "author": "Julian Tölle <julian.toelle97@gmail.com> & Loctax team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loc-tax/nest-pg-boss.git"
  },
  "bugs": {
    "url": "https://github.com/apricote/nest-pg-boss/issues"
  },
  "main": "./dist/index.js",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./test/jest-e2e.json"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "pg-boss": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.10",
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.8",
    "@testcontainers/postgresql": "11.8.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.0",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.46.3",
    "@typescript-eslint/parser": "8.46.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.5.0",
    "jest": "30.2.0",
    "pg-boss": "9.0.3",
    "prettier": "3.6.2",
    "rxjs": "7.8.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
